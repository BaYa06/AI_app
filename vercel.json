{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "devCommand": "npm run web",
  "installCommand": "npm install",
  "framework": null,
  "crons": [
    { "path": "/api/progress?action=close-week", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/push.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "flashlycards.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/join/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },

    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/bundle.(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.wav",
      "headers": [
        { "key": "Content-Type", "value": "audio/wav" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/correct.wav",
      "headers": [
        { "key": "Content-Type", "value": "audio/wav" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/correct2.wav",
      "headers": [
        { "key": "Content-Type", "value": "audio/wav" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!(?:api|ai|s|join|privacy|terms|support|delete-account|admin|site|icons|fonts|\\.well-known|en|learn|how-to-learn-words|spaced-repetition|teachers)(?:/|$))[^.]+)",
      "has": [{ "type": "host", "value": "flashlycards.app" }],
      "destination": "https://app.flashlycards.app/:path",
      "permanent": false
    },
    {
      "source": "/:page(privacy|terms)",
      "has": [{ "type": "host", "value": "ai-app-seven-zeta.vercel.app" }],
      "destination": "https://flashlycards.app/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/push/subscribe",            "destination": "/api/push?action=subscribe" },
    { "source": "/api/push/unsubscribe",           "destination": "/api/push?action=unsubscribe" },
    { "source": "/api/library/check-published",    "destination": "/api/library?action=check-published" },
    { "source": "/api/library/my-publications",    "destination": "/api/library?action=my-publications" },
    { "source": "/api/library/publish",            "destination": "/api/library?action=publish" },
    { "source": "/api/library/like",               "destination": "/api/library?action=like" },
    { "source": "/api/library/rate",               "destination": "/api/library?action=rate" },
    { "source": "/api/library/report",             "destination": "/api/library?action=report" },
    { "source": "/api/library/import",             "destination": "/api/library?action=import" },
    { "source": "/ai/:path*", "destination": "/api/ai?fn=:path*" },
    { "source": "/join/:token", "destination": "/api/join?token=:token" },
    { "source": "/s/:code", "destination": "/api/share?action=page&code=:code" },
    { "source": "/r/:code", "destination": "/api/share?action=report-page&code=:code" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/robots.txt", "has": [{ "type": "host", "value": "flashlycards.app" }], "destination": "/site/robots.txt" },
    { "source": "/sitemap.xml", "has": [{ "type": "host", "value": "flashlycards.app" }], "destination": "/site/sitemap.xml" },
    { "source": "/llms.txt", "has": [{ "type": "host", "value": "flashlycards.app" }], "destination": "/site/llms.txt" },
    { "source": "/en", "destination": "/site/p/en.html" },
    { "source": "/learn/english", "destination": "/site/p/learn-english.html" },
    { "source": "/learn/german", "destination": "/site/p/learn-german.html" },
    { "source": "/learn/turkish", "destination": "/site/p/learn-turkish.html" },
    { "source": "/how-to-learn-words", "destination": "/site/p/how-to-learn-words.html" },
    { "source": "/spaced-repetition", "destination": "/site/p/spaced-repetition.html" },
    { "source": "/teachers", "destination": "/site/p/teachers.html" },
    { "source": "/support", "destination": "/site/support.html" },
    { "source": "/delete-account", "destination": "/site/delete-account.html" },
    { "source": "/api/translate-words",           "destination": "/api/ai?fn=translate-words" },
    { "source": "/api/generate-examples",         "destination": "/api/ai?fn=generate-examples" },
    { "source": "/api/context",                   "destination": "/api/ai?fn=context" },
    { "source": "/api/extract-pdf",               "destination": "/api/ai?fn=extract-pdf" },
    { "source": "/api/extract-image",             "destination": "/api/ai?fn=extract-image" },
    { "source": "/api/import-files",              "destination": "/api/ai?fn=import-files" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!.*\\.).*)", "has": [{ "type": "host", "value": "flashlycards.app" }], "destination": "/site/404.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
