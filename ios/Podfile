# Firebase Analytics без рекламного идентификатора (IDFA): не нужен запрос App Tracking Transparency
$RNFirebaseAnalyticsWithoutAdIdSupport = true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FlashcardsApp' do
  config = use_native_modules!

  # React Native Firebase (push): Swift-поды Firebase требуют modular headers у своих
  # зависимостей, иначе pod install падает без use_frameworks!, который ломает другие поды.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RN 0.73 добавляет «-Wl -ld_classic» для любого Xcode ≥ 15 — обход бага нового линковщика Xcode 15.0.
    # На свежем Xcode (Codemagic: xcode latest) классический ld64 падает на бинарном Firebase Analytics:
    # «ld: Assertion failed: (it != _dylibToOrdinal.end())». С Xcode 15.1 новый линковщик исправлен —
    # снимаем флаг (в новых версиях RN его тоже больше не добавляют).
    xcode = `xcodebuild -version`.match(/Xcode (\d+)\.(\d+)/)
    if xcode && (xcode[1].to_i > 15 || (xcode[1].to_i == 15 && xcode[2].to_i >= 1))
      projects = [installer.pods_project] + installer.aggregate_targets.map(&:user_project).compact.uniq
      projects.each do |project|
        project.build_configurations.each do |build_config|
          flags = build_config.build_settings['OTHER_LDFLAGS']
          if flags.is_a?(Array)
            build_config.build_settings['OTHER_LDFLAGS'] = flags.reject { |f| f == '-ld_classic' || f == '-Wl' }
          elsif flags.is_a?(String)
            build_config.build_settings['OTHER_LDFLAGS'] = flags.gsub(/\s*-Wl\s+-ld_classic\b/, '').strip
          end
        end
        project.save
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        end
        config.build_settings['SWIFT_SERIALIZE_DEBUGGING_OPTIONS'] = 'NO'
      end
    end

    # Fix lottie-ios modulemap path: replace dynamic build path with static Pods path
    # The archive build puts products at a different path, so the dynamic reference fails
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_path|
      xcconfig = File.read(xcconfig_path)
      xcconfig_modified = xcconfig.gsub(
        /\$[\(\{]PODS_CONFIGURATION_BUILD_DIR[\)\}]\/lottie-ios\/Lottie\.modulemap/,
        '$(PODS_ROOT)/Headers/Public/Lottie/lottie-ios.modulemap'
      )
      File.open(xcconfig_path, 'w') { |f| f.write(xcconfig_modified) } if xcconfig_modified != xcconfig
    end
  end
end
